    "Shows the bubble for the current input source without switching. For a shortcut such as Option+P, run keyboardctl bind option+p peek.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the bubble for the current input source without switching. For a shortcut such as Option+P, run keyboardctl bind option+p peek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不切换输入源，只显示当前输入源的气泡。要使用 Option+P 等快捷键，请运行 keyboardctl bind option+p peek。"
          }
