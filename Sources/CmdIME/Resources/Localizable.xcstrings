          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME は GitHub に最新リリースを問い合わせます。それ以外は送信しません。"
          }
        }
      }
    },
    "CmdIME cannot write to %@. Update with the install command instead.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME cannot write to %@. Update with the install command instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME 无法写入 %@。请改用安装命令更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME は %@ に書き込めません。インストールコマンドで更新してください。"
          }
        }
      }
    },
    "CmdIME checks each key event in memory, by key code and modifier state, only to spot your triggers. What you type is never stored and never sent anywhere. The only thing saved is your own configuration.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME checks each key event in memory, by key code and modifier state, only to spot your triggers. What you type is never stored and never sent anywhere. The only thing saved is your own configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME 仅在内存中根据键码和修饰键状态检查每个按键事件，以识别触发键。输入内容不会被保存，也不会发送到任何地方。唯一保存的是你自己的配置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME はトリガーを見つけるためだけに、各キーイベントのキーコードと修飾キーの状態をメモリ上で確認します。入力内容は保存されず、どこにも送信されません。保存するのは設定だけです。"
          }
        }
      }
    },
    "CmdIME never switches input sources for itself.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME never switches input sources for itself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME 不会切换自身的输入源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME 自身の入力ソースは切り替えません。"
          }
        }
      }
    },
    "CmdIME not in the list yet? Request Permissions makes macOS add it.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
