    "Press a modifier together with an ordinary key.\nReturn saves · Esc cancels · Delete clears the draft.\nTab moves to buttons; Space or Return activates the focused button.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a modifier together with an ordinary key.\nReturn saves · Esc cancels · Delete clears the draft.\nTab moves to buttons; Space or Return activates the focused button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请同时按下修饰键和普通按键。\nReturn 保存 · Esc 取消 · Delete 清空草稿。\nTab 移动到按钮；空格或 Return 激活焦点按钮。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーと通常のキーを同時に押してください。\nReturn で保存 · Esc でキャンセル · Delete で下書きを消去。\nTab でボタンに移動し、Space または Return でフォーカス中のボタンを実行します。"
          }
        }
      }
    },
