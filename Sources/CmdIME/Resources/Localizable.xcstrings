          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回应用时，选中你上次在其中使用的输入源。不保存到磁盘；键盘控制暂停时不生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに戻ると、そこで最後に使った入力ソースを選択します。ディスクには保存せず、キーボード制御の一時停止中は動作しません。"
