        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %lld%% 未満に縮小できません。"
          }
        }
      }
    },
    "%@ failed: %@": {
      "extractionState": "manual",
      "generatesSymbol": false,
