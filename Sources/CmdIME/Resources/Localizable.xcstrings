        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はキー未設定です"
          }
        }
      }
    },
    "%@ has no matching input source, so its trigger cannot switch yet. Choose a source for it on the slot board.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no matching input source, so its trigger cannot switch yet. Choose a source for it on the slot board."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有匹配的输入源，因此触发键还无法切换。请在槽位面板为其选择输入源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に一致する入力ソースがないため、まだトリガーで切り替えられません。スロットボードで入力ソースを選んでください。"
          }
        }
      }
    },
    "%@ has no trigger yet.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no trigger yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未绑定触发键。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはまだトリガーがありません。"
          }
        }
      }
    },
    "%@ has room for %@ only. Your choice is kept for the other themes.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has room for %@ only. Your choice is kept for the other themes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只能显示 %@。你的选择会保留用于其他主题。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ のみ表示できます。選択はほかのテーマ用に保持されます。"
          }
        }
      }
    },
    "%@ has the unknown value %@.": {
      "extractionState": "manual",
