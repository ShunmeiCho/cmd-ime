    "This recorder only accepts keyboard shortcuts.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recorder only accepts keyboard shortcuts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录制器仅接受键盘快捷键。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレコーダーはキーボードショートカットのみ受け付けます。"
          }
        }
      }
    },
    "This replaces all slots and triggers, including key remaps, with one slot per installed primary language. Your current configuration will be backed up before replacement. General indicator settings are kept; slot-specific colors are reset.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces all slots and triggers, including key remaps, with one slot per installed primary language. Your current configuration will be backed up before replacement. General indicator settings are kept; slot-specific colors are reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会替换所有槽位和触发键（包括按键重映射），为每种已安装的主要语言创建一个槽位。替换前会备份当前配置。通用指示气泡设置会保留，槽位专属颜色会重置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーのリマップを含むすべてのスロットとトリガーを、インストール済みの主要言語ごとのスロットに置き換えます。現在の設定は置き換え前にバックアップされます。インジケーターの共通設定は保持され、スロット固有の色はリセットされます。"
          }
        }
      }
    },
    "This theme prints with its own inks.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This theme prints with its own inks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主题使用自己的油墨颜色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマは独自のインクを使います。"
          }
        }
      }
    },
    "Three short steps. Everything stays editable afterwards, and General > Show Setup Guide shows this guide again.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three short steps. Everything stays editable afterwards, and General > Show Setup Guide shows this guide again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需三个简短步骤。之后仍可随时修改，也可通过“通用 > 显示设置向导”再次打开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い 3 ステップです。すべて後から編集でき、「一般 > セットアップガイドを表示」で再度開けます。"
          }
        }
      }
    },
