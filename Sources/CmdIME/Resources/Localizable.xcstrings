    "CmdIME asks GitHub for the newest release. Nothing else is sent.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CmdIME asks GitHub for the newest release. Nothing else is sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
