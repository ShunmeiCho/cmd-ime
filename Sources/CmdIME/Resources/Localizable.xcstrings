        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " — 由 %@ 使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " — %@ が使用中"
          }
        }
      }
    },
    "\"%@\" is not a release version.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not a release version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是发布版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はリリースバージョンではありません。"
          }
        }
      }
    },
    "%@ %@  %@%@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@  %@%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@  %@%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@  %@%@"
          }
        }
      }
    },
    "%@ (%@)": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）"
          }
        }
      }
    },
    "%@ (no input source matched)": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (no input source matched)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（未匹配到输入源）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（一致する入力ソースなし）"
          }
        }
      }
    },
    "%@ On first launch CmdIME creates one slot per installed language.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ On first launch CmdIME creates one slot per installed language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 首次启动时，CmdIME 会为每种已安装的语言创建一个槽位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 初回起動時に、CmdIME はインストール済みの言語ごとにスロットを作成します。"
          }
        }
      }
    },
    "%@ Use Change to bind one.%@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Use Change to bind one.%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 点击“更改”来绑定按键。%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 「変更」でキーを割り当ててください。%@"
          }
        }
      }
    },
    "%@ already exists. Choose a new name; nothing is ever written over.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already exists. Choose a new name; nothing is ever written over."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在。请选择新名称；不会覆盖任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに存在します。別の名前を選んでください。上書きは行いません。"
          }
        }
      }
    },
    "%@ already used by %@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already used by %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被 %@ 使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに %@ で使用されています"
          }
        }
      }
    },
    "%@ cannot be used as a font file name.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cannot be used as a font file name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不能用作字体文件名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はフォントのファイル名に使用できません。"
          }
        }
      }
    },
    "%@ cannot be used as a theme id.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cannot be used as a theme id."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不能用作主题 ID。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はテーマ ID に使用できません。"
          }
        }
      }
    },
    "%@ contrast %.1f:1, below %.1f:1": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ contrast %.1f:1, below %.1f:1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 对比度 %.1f:1，低于 %.1f:1"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のコントラスト %.1f:1、基準 %.1f:1 未満"
          }
        }
      }
    },
    "%@ does not shrink below %lld%%.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
