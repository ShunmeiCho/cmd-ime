    "Detection makes one slot per language, so input sources that share a language share one slot. To switch between them, add a slot on the slot board with Change.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection makes one slot per language, so input sources that share a language share one slot. To switch between them, add a slot on the slot board with Change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测会为每种语言创建一个槽位，因此同一语言的输入源会共用槽位。要在它们之间切换，请点击“更改”到槽位面板添加槽位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出では言語ごとに 1 つのスロットを作るため、同じ言語の入力ソースはスロットを共有します。切り替えるには、「変更」からスロットボードでスロットを追加してください。"
          }
        }
      }
    },
