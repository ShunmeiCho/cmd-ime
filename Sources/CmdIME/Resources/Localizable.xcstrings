    "It has %lld slot(s), %lld theme(s), %lld font(s)%@. Your current settings are copied to a backup folder first and take effect again if you import that folder.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has %lld slot(s), %lld theme(s), %lld font(s)%@. Your current settings are copied to a backup folder first and take effect again if you import that folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中包含 %lld 个槽位、%lld 个主题、%lld 个字体%@。当前设置会先复制到备份文件夹，导入该文件夹即可恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スロット %lld 個、テーマ %lld 個、フォント %lld 個%@が含まれています。現在の設定は先にバックアップフォルダにコピーされ、そのフォルダを読み込むと元に戻せます。"
          }
        }
      }
    },
