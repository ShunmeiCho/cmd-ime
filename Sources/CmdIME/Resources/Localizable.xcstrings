            "value": "和"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "と"
          }
        }
      }
    },
    " — used by %@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " — used by %@"
