    "Lets CmdIME handle a trigger before other apps see it, and find the text caret for the switch indicator.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets CmdIME handle a trigger before other apps see it, and find the text caret for the switch indicator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 CmdIME 在其他应用接收到触发键之前处理它，并查找文本光标位置以显示切换指示气泡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリに届く前にトリガーを処理し、切り替えインジケーター用にキャレットの位置を取得できるようにします。"
          }
        }
      }
    },
    "Lets CmdIME see key presses while another app is in front, so triggers work everywhere.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets CmdIME see key presses while another app is in front, so triggers work everywhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 CmdIME 在其他应用位于前台时检测按键，让触发键在各处都能生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリが前面にあるときもキー入力を検出し、どこでもトリガーを使えるようにします。"
          }
        }
      }
    },
