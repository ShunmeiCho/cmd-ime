{
  "sourceLanguage": "en",
  "strings": {
    " %lld trigger(s) use an action this version does not have and were left out.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " %lld trigger(s) use an action this version does not have and were left out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " %lld 个触发键使用了此版本不支持的操作，已跳过。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " %lld 個のトリガーは、このバージョンにない操作を使用しているため除外しました。"
          }
        }
      }
    },
    " +%@ more": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " +%@ more"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，另有 %@ 个"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "、ほか %@ 件"
          }
        }
      }
    },
    " - used by %@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " - used by %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " - 被 %@ 使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " - %@ で使用"
          }
        }
      }
    },
    " On first detection, CmdIME automatically assigns up to %@ keys.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " On first detection, CmdIME automatically assigns up to %@ keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 首次检测时，CmdIME 最多自动分配 %@ 个按键。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 初回検出時、CmdIME は最大 %@ 個のキーを自動で割り当てます。"
          }
        }
      }
    },
    " The previous ones are in %@/%@.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The previous ones are in %@/%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 之前的设置位于 %@/%@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 以前の設定は %@/%@ にあります。"
          }
        }
      }
    },
    " Your previous settings are in %@.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Your previous settings are in %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 原来的设置保存在 %@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 以前の設定は %@ にあります。"
          }
        }
      }
    },
